  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de un formulario o pantalla.",
      "html": "<button class=\"ds-boton\">Guardar ficha</button>",
      "css": ".ds-boton{display:inline-flex;align-items:center;min-height:48px;padding:8px 24px;border:2px solid #15803d;border-radius:2px;background:#15803d;color:#fff;font-family:'Archivo Variable',system-ui,sans-serif;font-weight:700;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 150ms ease}.ds-boton:hover{background:#116c33;border-color:#116c33}.ds-boton:active{transform:scale(0.97)}.ds-boton:focus-visible{outline:3px solid #0f5c2d;outline-offset:3px}"
    },
    {
      "name": "Botón sobre la bolsa",
      "kind": "button",
      "refersTo": "button-on-bolsa",
      "description": "Acción principal dentro del campo verde.",
      "html": "<div class=\"ds-bolsa\"><button class=\"ds-boton-bolsa\">Recorrer en 3D</button></div>",
      "css": ".ds-bolsa{background:#14532d;padding:24px}.ds-boton-bolsa{min-height:48px;padding:8px 24px;border:2px solid #f4f8f3;border-radius:2px;background:#f4f8f3;color:#14532d;font-family:'Archivo Variable',system-ui,sans-serif;font-weight:700;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1)}.ds-boton-bolsa:hover{background:#fff}.ds-boton-bolsa:active{transform:scale(0.97)}.ds-boton-bolsa:focus-visible{outline:3px solid #f4f8f3;outline-offset:3px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input",
      "description": "Control de formulario; el error va debajo del campo.",
      "html": "<label class=\"ds-campo\"><span>Nombre común</span><input class=\"ds-control\" value=\"Toronjil\"></label>",
      "css": ".ds-campo{display:flex;flex-direction:column;gap:4px;font-family:'Archivo Variable',system-ui,sans-serif;font-weight:700;font-size:15px;color:#0f2417}.ds-control{min-height:48px;padding:8px 12px;border:2px solid #8fa996;border-radius:2px;background:#f4f8f3;color:#0f2417;font:inherit;font-weight:400;font-size:16px}.ds-control:focus{outline:3px solid #0f5c2d;outline-offset:1px;border-color:#15803d}"
    },
    {
      "name": "Navegación",
      "kind": "nav",
      "description": "Barra plana en el verde de la bolsa con indicador inferior.",
      "html": "<nav class=\"ds-barra\"><a class=\"ds-activo\">Mapa</a><a>Calendario lunar</a><a>Ingresar</a></nav>",
      "css": ".ds-barra{display:flex;gap:4px;background:#14532d;padding:0 16px;font-family:'Archivo Variable',system-ui,sans-serif}.ds-barra a{position:relative;padding:18px 16px;color:#c9dccd;font-weight:600;text-decoration:none}.ds-barra a:hover{color:#f4f8f3}.ds-barra .ds-activo{color:#f4f8f3}.ds-barra .ds-activo::after{content:'';position:absolute;left:16px;right:16px;bottom:0;height:4px;background:#f4f8f3}"
    },
    {
      "name": "Sello de clasificación",
      "kind": "chip",
      "description": "Estado como marca de tinta con texto.",
      "html": "<span class=\"ds-sello ds-caliente\">Caliente</span> <span class=\"ds-sello ds-fria\">Fría</span>",
      "css": ".ds-sello{display:inline-flex;padding:3px 8px;border:2px solid currentColor;border-radius:4px;font-family:'Archivo Variable',system-ui,sans-serif;font-stretch:75%;font-weight:800;font-size:15px;transform:rotate(-2deg)}.ds-caliente{color:#b4320f}.ds-fria{color:#046c4e}"
    },
    {
      "name": "Etiqueta de huerto",
      "kind": "card",
      "refersTo": "etiqueta",
      "description": "Firma del sistema: papel troquelado con campos en bandas de tono.",
      "html": "<article class=\"ds-etiqueta\"><h3>Huerto demostrativo Sumak Kawsay</h3><dl><div><dt>Provincia</dt><dd>Pichincha</dd></div><div><dt>Plantas</dt><dd>4</dd></div></dl></article>",
      "css": ".ds-etiqueta{background:#f4f8f3;color:#0f2417;font-family:'Archivo Variable',system-ui,sans-serif;clip-path:polygon(12px 0,calc(100% - 12px) 0,100% 12px,100% calc(100% - 12px),calc(100% - 12px) 100%,12px 100%,0 calc(100% - 12px),0 12px)}.ds-etiqueta h3{margin:0;padding:24px 24px 16px;font-stretch:62%;font-weight:800;font-size:28px;line-height:1.02}.ds-etiqueta dl{display:grid;grid-template-columns:1fr 1fr;gap:2px;margin:0}.ds-etiqueta dl div{background:#dde8de;padding:12px 16px}.ds-etiqueta dt{font-size:15px;font-weight:600;color:#2c4334}.ds-etiqueta dd{margin:0;font-weight:600}"
    }
  ],
  "narrative": {
    "northStar": "La etiqueta de la planta seca",
    "overview": "Cada huerto y cada planta se presentan como la etiqueta oficial de empaque de los lineamientos del MSP: datos verificables primero, en campos apretados sobre papel claro, dentro del campo verde de la bolsa. Rechaza la app de mapas genérica de tarjetas con sombra, íconos teñidos y degradados.",
    "keyCharacteristics": [
      "Campo verde de la bolsa en el primer tercio de cada pantalla pública",
      "Archivo condensado al 62 % para títulos y cifras",
      "Etiquetas troqueladas con campos en bandas de tono",
      "Sellos de tinta con texto para cada estado",
      "Láminas botánicas de dominio público con crédito"
    ],
    "rules": [
      {
        "name": "La regla del sello",
        "body": "Todo estado es una marca con texto, nunca solo color.",
        "section": "colors"
      },
      {
        "name": "La regla de la tinta llena",
        "body": "El texto corrido nunca va en gris.",
        "section": "colors"
      },
      {
        "name": "Plano por tono",
        "body": "Las superficies se separan por pasos de tono; solo lo que flota lleva sombra.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Componer cada registro como su etiqueta",
      "Marcar estados con sellos de texto",
      "Acreditar cada lámina"
    ],
    "donts": [
      "Antetítulos",
      "Sombras en reposo, degradados o vidrio",
      "Líneas finas para separar",
      "Íconos en cuadros teñidos",
      "Texto corrido en gris"
    ]
  }
