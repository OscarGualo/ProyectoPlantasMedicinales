# Copia este archivo como .env (no se sube al repositorio) y cambia los valores.
# docker compose lo lee automáticamente.

# Base de datos local del contenedor postgres
DB_USER=huertos
DB_PASSWORD=huertos

# Contraseña de lider.demo1, lider.demo2 y lider.demo3. Se aplica solo la primera vez que se crea la base;
# para cambiarla: docker compose down -v
DEMO_PASSWORD=cambia-esta-clave

# Puerto del host para la aplicación completa (docker compose --profile app up)
APP_PORT=8080
